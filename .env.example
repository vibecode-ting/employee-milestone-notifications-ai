# ====================================================
# annual_notifications — Environment Variables
# Copy this to .env and fill in your values
# ====================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_SECRET=change_me_to_a_random_32_char_string

# --- Database ---
# Default: SQLite (zero setup). Switch to PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/annual_notifications"
DATABASE_URL="file:./dev.db"

# --- Gemini AI (Free Tier — Google AI Studio) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Vertex AI (Optional — Hackathon GCP Mode) ---
# Set BOTH to enable Vertex AI (gemini-2.5-flash/pro + Imagen 3)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Email (Optional — leave blank for free Ethereal Sandbox) ---
# Gmail Easy Setup (recommended for quick start):
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Custom SMTP (alternative):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
SMTP_SENDER_NAME=People & Culture AI

# Resend API (free tier: 3000 emails/month):
RESEND_API_KEY=re_your_resend_api_key

# --- Webhooks (Optional) ---
TEAMS_WEBHOOK_URL=https://yourorg.webhook.office.com/webhookb2/...
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
